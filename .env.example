# ==============================================================================
# VALETEC PHARMA - VARIABLES DE ENTORNO (PLANTILLA OFICIAL)
# ==============================================================================
# Copia este archivo como '.env' en la raíz del proyecto y asigna valores reales.
# NUNCA subas el archivo '.env' con contraseñas reales a GitHub o repositorios públicos.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENTORNO Y SERVIDOR HTTP
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
PUERTO=4030
FRONTEND_PUERTO=5186
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS (POSTGRESQL 16)
# ------------------------------------------------------------------------------
DB_CLIENT=postgres
PGHOST=localhost
PGPORT=5442
BD_PUERTO=5442
PGUSER=valetec_user
PGPASSWORD=cambiar_por_contrasena_segura_aqui
PGDATABASE=valetec_pharma

# ------------------------------------------------------------------------------
# 3. SEGURIDAD, AUTENTICACIÓN Y WEBHOOKS
# ------------------------------------------------------------------------------
# Generar una clave de al menos 64 caracteres aleatorios para producción:
JWT_SECRET=cambiar_por_token_jwt_criptografico_seguro_aqui
POS_WEBHOOK_SECRET=cambiar_por_clave_secreta_webhook_aqui

# ------------------------------------------------------------------------------
# 4. FACTURACIÓN ELECTRÓNICA SUNAT (UBL 2.1)
# ------------------------------------------------------------------------------
SUNAT_ENV=beta
SUNAT_USER=20601234567MODDATOS
SUNAT_PASS=moddatos
CERT_PFX_PATH=./certs/certificate_demo.pfx

# ------------------------------------------------------------------------------
# 5. POLÍTICA DE RESPALDOS AUTOMATIZADOS (BACKUPS)
# ------------------------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=15
CONTAINER_NAME=valetec_pharma_postgres
